# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Multi-Exchange Trading API Keys (Live real trading connectivity)
# Direct production keys for Binance, Coinbase, Kraken, and NonKYC
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
NONKYC_API_KEY=
NONKYC_API_SECRET=

# Fiat & Live Currency Account Gateway (Stripe & Plaid)
# Connects to any bank account via ACH rails / Open Banking & processes debit card loads
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox   # sandbox | production (Plaid retired "development"); start in sandbox
# PLAID_REDIRECT_URI=         # needed in production for banks that sign in with OAuth; must be registered in the Plaid dashboard
# PLAID_STORE_PATH=           # default ./data/plaid-items.json (Plaid access tokens, mode 0600; back up and keep private)

# Flash Loan MEV Arbitrage Searcher Signer & Profit Vault
# Gas Funder / Searcher Execution Signer (Arbitrum & Base): 0xF1d765d693f9e6fAb0c4a2FCa942d9D54233C966
FLASH_ARB_GAS_WALLET=0xF1d765d693f9e6fAb0c4a2FCa942d9D54233C966
FLASH_ARB_SIGNER_KEY=

# Main Arbitrage Profit Destination Vault (100% of net profits swept directly to MetaMask): 0x65602EB9e09B07002872E074004400d37e27CCB9
FLASH_ARB_PROFIT_WALLET=0x65602EB9e09B07002872E074004400d37e27CCB9


# Optional hardening / config added in review
# API_ACCESS_TOKEN=            # required header x-api-token for non-local /api access
# MAX_ORDER_NOTIONAL_USD=      # reject live orders above this size
# RECEIVE_ADDRESS_XMR=         # your OWN receive address (the app no longer invents one)
# RECEIVE_SUBADDRESS_XMR=
# ENABLE_LIVE_TRADING=1       # server refuses real orders unless this is set

# --- Fiat (live money only) ---
# STRIPE_SECRET_KEY (sk_live_...) and STRIPE_PUBLISHABLE_KEY (pk_live_...) above are required for card deposits.
# Use a matching pair (both live or both test). The browser loads the publishable key from /api/fiat/config.
# STRIPE_WEBHOOK_SECRET=       # whsec_... ; point Stripe at POST /api/fiat/stripe/webhook (publicly reachable)
# FIAT_TOTP_SECRET=            # base32 TOTP secret (add to an authenticator app); required for transfers >= $2000 / loosening limits
# --- PayPal withdrawals (PayPal Payouts; your PayPal Business account needs Payouts enabled) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox                 # sandbox | live. Start in sandbox.
# PAYPAL_PAYOUT_RECIPIENTS=you@example.com   # comma-separated PayPal emails that may receive money. Nothing else can be paid.
# FIAT_DAILY_WITHDRAWAL_LIMIT_USD=1000
# Optional: point a PayPal webhook at POST /api/fiat/paypal/webhook (PAYMENT.PAYOUTS-ITEM.* / PAYMENT.PAYOUTSBATCH.*) for faster status updates.
# FIAT_LEDGER_PATH=            # default ./data/fiat-ledger.json (back this file up: it is your balance record)
# FIAT_DAILY_DEPOSIT_LIMIT_USD=50000

# --- Other variables the code reads (documented in review) ---
# APP_PORT=3000                 # overrides PORT (PORT=8080 is ignored on purpose; Cloud Run/nginx sets it)
# HOST=127.0.0.1                # bind address (default 127.0.0.1; 0.0.0.0 only when K_SERVICE is set)
# DISABLE_HMR=true              # Vite hot reload off
# OKX_API_KEY=                  # /api/exchange routes: OKX
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# FLASH_ARB_OWNER_ADDRESS=      # searcher: simulate as this owner when FLASH_ARB_SIGNER_KEY is not on this machine
# RUST_LOG=info                 # searcher log level
# SQL_HOST= / SQL_USER= / SQL_PASSWORD= / SQL_DB_NAME=   # Postgres for the Firebase-authed /api/user|portfolio|strategy routes only
# SQL_ADMIN_USER= / SQL_ADMIN_PASSWORD=                  # drizzle-kit migrations only
# CONFIRM_DEPLOY=yes            # scripts/deploy-flash-arb.cjs: without it, it only previews the deploy
# ARBITRUM_RPC_URL=             # Optional dedicated RPC (e.g. Alchemy/Infura/QuickNode); default public failover pool
# BASE_RPC_URL=                 # Optional dedicated Base RPC
# OPTIMISM_RPC_URL=             # Optional dedicated Optimism RPC

# Etherscan API key (https://etherscan.io/myapikey). Used by server/etherscanService.ts via the
# Etherscan V2 API (live ETH price + gas oracle). One key works across Ethereum/Arbitrum/Base/Optimism.
ETHERSCAN_API_KEY=
